legacy .fresh .brand-film-mark{display:inline-block;width:35px;height:60px;background:#fff url('/assets/logo-large.webp') left center/auto 100% no-repeat;vertical-align:middle;margin-bottom:22px;flex:none}
legacy .fresh .enquiry-actions .call-button{background:transparent;color:inherit;border:1px solid currentColor}
legacy .fresh .enquiry-actions .call-button:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
legacy .fresh [data-surface=ink] .enquiry-actions .call-button:hover{background:#fff;color:var(--ink);border-color:#fff}
legacy .mobile-enquiry-bar .call-button{color:white;border:1px solid #ffffff80;background:transparent}
compiled .fresh .brand-film-mark{vertical-align:middle;background:#fff url(/assets/logo-large.webp) 0/auto 100% no-repeat;flex:none;width:35px;height:60px;margin-bottom:22px;display:inline-block}
compiled .fresh .enquiry-actions .call-button{color:inherit;background:0 0;border:1px solid}
compiled .fresh .enquiry-actions .call-button:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
compiled .fresh [data-surface=ink] .enquiry-actions .call-button:hover{color:var(--ink);background:#fff;border-color:#fff}
compiled .mobile-enquiry-bar .call-button{color:#fff;background:0 0;border:1px solid #ffffff80}
